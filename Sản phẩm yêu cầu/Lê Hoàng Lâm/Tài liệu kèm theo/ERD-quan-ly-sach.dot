digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.6", fontname="DejaVu Sans"];
 node [shape=record, fontname="DejaVu Sans", fontsize=11, style="filled", fillcolor="#f5f7fa", color="#556070"];
 edge [fontname="DejaVu Sans", fontsize=10, color="#556070", arrowsize=0.7];
 Sach [label="{Sach|PK MaSach : INT IDENTITY\lISBN : VARCHAR(13), NULL\lTenSach : NVARCHAR(200)\lFK MaTheLoai : INT\lFK MaNXB : INT\lNamXuatBan : SMALLINT\lHinhThuc : TINYINT\lGiaBan : DECIMAL(12,0)\lTrangThai : TINYINT\lFK NguoiTao / NguoiCapNhat\l}"];
